  <script>
    let quoteItems = [];
    document.getElementById('quoteDate').valueAsDate = new Date();

    function onTypeChange() {
      const select = document.getElementById('itemType');
      const option = select.options[select.selectedIndex];
      const val = select.value;
      const isFixed = option.getAttribute('data-fixed') === 'true';

      if (val === 'custom') {
        document.getElementById('itemPrice').value = 0;
        document.getElementById('dimFields').style.display = 'none';
      } else if (isFixed) {
        document.getElementById('itemPrice').value = val;
        document.getElementById('dimFields').style.display = 'none';
      } else {
        document.getElementById('itemPrice').value = val;
        document.getElementById('dimFields').style.display = 'grid';
      }
      updateLiveCalculation();
    }

    function updateLiveCalculation() {
      const select = document.getElementById('itemType');
      const option = select.options[select.selectedIndex];
      const price = parseFloat(document.getElementById('itemPrice').value) || 0;
      const qty = parseFloat(document.getElementById('itemQty').value) || 0;
      const w = parseFloat(document.getElementById('dimWidth').value) || 0;
      const h = parseFloat(document.getElementById('dimHeight').value) || 0;
      const unit = option.getAttribute('data-unit');
      const isFixed = option.getAttribute('data-fixed') === 'true';

      let totalConcepto = 0;

      if (isFixed || select.value === 'custom') {
        totalConcepto = qty * price;
      } else if (unit === 'm²') {
        totalConcepto = (w * h) * price * qty;
      } else if (unit === 'ml') {
        totalConcepto = (w + h) * price * qty;
      } else if (unit === 'kg') {
        totalConcepto = ((w * h) * 20) * price * qty;
      }

      document.getElementById('liveSubtotalVal').innerText = '$' + totalConcepto.toLocaleString('es-MX', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' MXN';
    }

    function addItemToQuote() {
      const select = document.getElementById('itemType');
      const option = select.options[select.selectedIndex];
      let name = option.getAttribute('data-name');
      const price = parseFloat(document.getElementById('itemPrice').value) || 0;
      const qty = parseFloat(document.getElementById('itemQty').value) || 1;
      const w = parseFloat(document.getElementById('dimWidth').value) || 0;
      const h = parseFloat(document.getElementById('dimHeight').value) || 0;
      const unit = option.getAttribute('data-unit');
      const isFixed = option.getAttribute('data-fixed') === 'true';

      let totalConcepto = 0;
      let desc = name;

      if (isFixed || select.value === 'custom') {
        totalConcepto = qty * price;
      } else if (unit === 'm²') {
        const area = (w * h);
        totalConcepto = area * price * qty;
        desc += ` (${w}m x ${h}m = ${area.toFixed(2)} m²)`;
      } else if (unit === 'ml') {
        const ml = (w + h);
        totalConcepto = ml * price * qty;
        desc += ` (${ml.toFixed(2)} ml)`;
      } else if (unit === 'kg') {
        const kg = (w * h * 20);
        totalConcepto = kg * price * qty;
        desc += ` (~${kg.toFixed(0)} kg de acero)`;
      }

      quoteItems.push({
        description: desc,
        quantity: qty,
        unitPrice: price,
        total: totalConcepto
      });

      renderQuoteTable();
    }

    function deleteItem(index) {
      quoteItems.splice(index, 1);
      renderQuoteTable();
    }

    function renderQuoteTable() {
      const tbody = document.getElementById('quoteTableBody');
      tbody.innerHTML = '';

      let grandTotal = 0;

      if (quoteItems.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">No hay conceptos agregados aún. Selecciona un trabajo arriba y haz clic en "Agregar Concepto".</td></tr>';
      } else {
        quoteItems.forEach((item, index) => {
          grandTotal += item.total;
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td><strong>${item.description}</strong></td>
            <td>${item.quantity}</td>
            <td>$${item.unitPrice.toLocaleString('es-MX', {minimumFractionDigits: 2})}</td>
            <td style="color: var(--samest-blue-light); font-weight: 600;">$${item.total.toLocaleString('es-MX', {minimumFractionDigits: 2})}</td>
            <td><button class="btn-delete-row" onclick="deleteItem(${index})">✕</button></td>
          `;
          tbody.appendChild(tr);
        });
      }

      const advance = grandTotal * 0.50;
      const progress = grandTotal * 0.25;
      const finalPay = grandTotal * 0.25;

      document.getElementById('grandTotal').innerText = '$' + grandTotal.toLocaleString('es-MX', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' MXN';
      document.getElementById('payAdvance').innerText = '$' + advance.toLocaleString('es-MX', {minimumFractionDigits: 2, maximumFractionDigits: 2});
      document.getElementById('payProgress').innerText = '$' + progress.toLocaleString('es-MX', {minimumFractionDigits: 2, maximumFractionDigits: 2});
      document.getElementById('payFinal').innerText = '$' + finalPay.toLocaleString('es-MX', {minimumFractionDigits: 2, maximumFractionDigits: 2});
    }

    function copyOrSendWhatsApp() {
      const client = document.getElementById('clientName').value || 'Cliente General';
      const loc = document.getElementById('projectLocation').value || 'Por definir';
      const time = document.getElementById('executionTime').value || '5 a 8 días hábiles';
      const total = document.getElementById('grandTotal').innerText;

      if (quoteItems.length === 0) {
        alert('Por favor agrega al menos un concepto a la cotización.');
        return;
      }

      let msg = `*COTIZACIÓN FORMAL - SAMEST ESTRUCTURAS*\\n`;
      msg += `👤 *Cliente:* ${client}\\n`;
      msg += `📍 *Ubicación:* ${loc}\\n`;
      msg += `⏱️ *Tiempo de ejecución:* ${time}\\n\\n`;
      msg += `*CONCEPTOS DESGLOSADOS:*\\n`;

      quoteItems.forEach((item, idx) => {
        msg += `${idx + 1}. ${item.description} - Cant: ${item.quantity} - Total: $${item.total.toLocaleString('es-MX', {minimumFractionDigits: 2})} MXN\\n`;
      });

      msg += `\\n*TOTAL INVERSIÓN:* ${total}\\n`;
      msg += `• 50% Anticipo: ${document.getElementById('payAdvance').innerText}\\n`;
      msg += `• 25% al 70% avance: ${document.getElementById('payProgress').innerText}\\n`;
      msg += `• 25% Finiquito entrega: ${document.getElementById('payFinal').innerText}\\n\\n`;
      msg += `_Incluye material, habilitado, mano de obra, primario anticorrosivo e instalación._\\n`;
      msg += `¿Podemos agendar visita técnica de rectificación en obra?`;

      const url = 'https://wa.me/525645855721?text=' + encodeURIComponent(msg);
      window.open(url, '_blank');
    }

    function sendSpecialProjectToWhatsApp() {
      const type = document.getElementById('specialType').value || 'Proyecto Especial No Paramétrico';
      const dims = document.getElementById('specialDims').value || 'Dimensiones por definir';
      const loc = document.getElementById('specialLocation').value || 'Por definir';
      const notes = document.getElementById('specialNotes').value || 'Sin detalles adicionales';

      let msg = `*SOLICITUD DE REVISIÓN - PROYECTO ESPECIAL SAMEST*\\n`;
      msg += `🏗️ *Tipo de Proyecto:* ${type}\\n`;
      msg += `📐 *Dimensiones / Área:* ${dims}\\n`;
      msg += `📍 *Ubicación de Obra:* ${loc}\\n`;
      msg += `📝 *Detalles Técnicos:* ${notes}\\n\\n`;
      msg += `Hola Samuel / Equipo SAMEST, este proyecto requiere revisión personalizada. ¿Podrían revisarlo para cotización a medida?`;

      const url = 'https://wa.me/525645855721?text=' + encodeURIComponent(msg);
      window.open(url, '_blank');
    }

    // Filtrado de Galería
    function filterGallery(category) {
      const buttons = document.querySelectorAll('.filter-btn');
      buttons.forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');

      const cards = document.querySelectorAll('.gallery-card');
      cards.forEach(card => {
        if (category === 'todos' || card.getAttribute('data-category') === category) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Modal Lightbox
    function openLightbox(imgSrc, title, desc) {
      const modal = document.getElementById('lightboxModal');
      const img = document.getElementById('lightboxImg');
      const t = document.getElementById('lightboxTitle');
      const d = document.getElementById('lightboxDesc');
      const btn = document.getElementById('lightboxWaBtn');

      img.src = imgSrc;
      img.onerror = function() {
        this.src = 'https://images.unsplash.com/photo-1541888946425-d0fbb186156f?w=800&auto=format&fit=crop&q=80';
      };
      t.innerText = title;
      d.innerText = desc;

      const waMsg = `Hola Samuel / Equipo SAMEST, vi en su álbum web la obra "${title}" y me gustaría cotizar un trabajo similar para mi proyecto.`;
      btn.href = 'https://wa.me/525645855721?text=' + encodeURIComponent(waMsg);

      modal.style.display = 'flex';
    }

    function closeLightbox() {
      document.getElementById('lightboxModal').style.display = 'none';
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeLightbox();
    });

    onTypeChange();
    addItemToQuote();
  </script>
