<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SAMEST Estructuras | Cotizador, Precios y Álbum de Obras</title>
  <meta name="description" content="SAMEST Estructuras. Precios actualizados, cotizador digital, álbum fotográfico de obras y atención para herrería y estructuras metálicas.">
  <style>
    :root {
      /* Colores Oficiales extraídos del Logotipo de SAMEST */
      --samest-blue-bright: #1b5ca4;
      --samest-blue-dark: #0a1f36;
      --samest-blue-light: #60a5fa;
      --samest-steel-gray: #474f59;
      --samest-metal-silver: #d1d5db;
      
      --bg-dark: #090e15;
      --bg-card: #111a24;
      --bg-card-hover: #162230;
      --border-color: #1e2e42;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --radius: 12px;
      --shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.6);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      line-height: 1.6;
      overflow-x: hidden;
    }

    .container {
      width: 90%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 2.5rem 0;
    }

    /* Navbar */
    header {
      position: sticky;
      top: 0;
      background-color: rgba(9, 14, 21, 0.95);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border-color);
      z-index: 1000;
      padding: 0.85rem 0;
    }

    .nav-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 90%;
      max-width: 1200px;
      margin: 0 auto;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .logo-icon-svg {
      width: 44px;
      height: 44px;
      flex-shrink: 0;
    }

    .brand-text-block {
      display: flex;
      flex-direction: column;
    }

    .brand-title {
      font-family: 'Times New Roman', Georgia, serif;
      font-size: 1.45rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: #ffffff;
      line-height: 1.1;
    }

    .brand-subtitle {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 3px;
      color: var(--samest-blue-light);
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      gap: 1.5rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 500;
      transition: color 0.2s ease;
    }

    .nav-links a:hover {
      color: var(--samest-blue-light);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: all 0.25s ease;
      font-size: 0.95rem;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--samest-blue-bright) 0%, #123e70 100%);
      color: #ffffff;
      box-shadow: 0 4px 15px rgba(27, 92, 164, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, #236bc0 0%, #164e8d 100%);
      transform: translateY(-2px);
    }

    .btn-outline {
      background: transparent;
      color: var(--text-main);
      border: 1px solid var(--border-color);
    }

    .btn-outline:hover {
      border-color: var(--samest-blue-light);
      color: var(--samest-blue-light);
      background: rgba(27, 92, 164, 0.1);
    }

    .btn-whatsapp {
      background: #25d366;
      color: #ffffff;
      box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
    }

    .btn-whatsapp:hover {
      background: #1eb956;
      transform: translateY(-2px);
    }

    .hero {
      padding: 4.5rem 0 3.5rem 0;
      text-align: center;
      border-bottom: 1px solid var(--border-color);
      background: radial-gradient(circle at 50% 15%, rgba(27, 92, 164, 0.2) 0%, transparent 65%);
    }

    .badge {
      display: inline-block;
      padding: 0.4rem 1.25rem;
      border-radius: 50px;
      background-color: rgba(27, 92, 164, 0.25);
      color: var(--samest-blue-light);
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      border: 1px solid rgba(96, 165, 250, 0.3);
      letter-spacing: 0.5px;
    }

    .hero h1 {
      font-size: 2.85rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 1.25rem;
      max-width: 920px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero h1 span {
      background: linear-gradient(90deg, #ffffff 40%, var(--samest-blue-light) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      font-size: 1.15rem;
      color: var(--text-muted);
      max-width: 780px;
      margin: 0 auto 2.2rem auto;
    }

    .hero-actions {
      display: flex;
      justify-content: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 1.5rem;
      margin-top: 3.5rem;
    }

    .stat-card {
      background: var(--bg-card);
      padding: 1.6rem;
      border-radius: var(--radius);
      border: 1px solid var(--border-color);
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .stat-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--samest-blue-bright), var(--samest-blue-dark));
    }

    .stat-number {
      font-size: 2.1rem;
      font-weight: 800;
      color: var(--samest-blue-light);
      margin-bottom: 0.25rem;
    }

    .stat-desc {
      font-size: 0.88rem;
      color: var(--text-muted);
    }

    .section-header {
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .section-header h2 {
      font-size: 2.2rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }

    .section-header p {
      color: var(--text-muted);
      max-width: 650px;
      margin: 0 auto;
    }

    .prices-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius);
      padding: 2.25rem;
      box-shadow: var(--shadow);
    }

    .prices-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.25rem;
      margin-top: 1rem;
    }

    .price-item {
      background: #090e15;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.2s ease;
    }

    .price-item:hover {
      border-color: var(--samest-blue-bright);
      transform: translateY(-2px);
    }

    .price-item h4 {
      font-size: 1.05rem;
      color: #ffffff;
      margin-bottom: 0.35rem;
    }

    .price-item p {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-bottom: 0.85rem;
    }

    .price-tag {
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--samest-blue-light);
    }

    .price-unit {
      font-size: 0.8rem;
      color: #94a3b8;
      font-weight: normal;
    }

    .social-banner-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem;
      margin-top: 1rem;
    }

    .social-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius);
      padding: 2rem;
      text-align: center;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
    }

    .social-card:hover {
      border-color: var(--samest-blue-bright);
      transform: translateY(-4px);
    }

    .social-icon-box {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.25rem;
    }

    .fb-bg {
      background: rgba(24, 119, 242, 0.15);
      border: 1px solid rgba(24, 119, 242, 0.4);
      color: #1877f2;
    }

    .ig-bg {
      background: rgba(225, 48, 108, 0.15);
      border: 1px solid rgba(225, 48, 108, 0.4);
      color: #e1306c;
    }

    .special-project-card {
      background: linear-gradient(145deg, #111a24 0%, #0c141d 100%);
      border: 1px solid rgba(27, 92, 164, 0.5);
      border-radius: var(--radius);
      padding: 2.5rem;
      box-shadow: var(--shadow);
      margin-top: 2rem;
    }

    .cotizador-app-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius);
      padding: 2.5rem;
      box-shadow: var(--shadow);
      position: relative;
    }

    .cotizador-app-card::before {
      content: "";
      position: absolute;
      top: -1px;
      left: 10%;
      right: 10%;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--samest-blue-bright), transparent);
    }

    .cotizador-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .form-group {
      margin-bottom: 1.2rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.45rem;
      font-weight: 600;
      font-size: 0.9rem;
      color: #e2e8f0;
    }

    .form-control {
      width: 100%;
      padding: 0.75rem 1rem;
      background: #090e15;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      color: var(--text-main);
      font-size: 0.95rem;
      transition: border-color 0.2s;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--samest-blue-light);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .table-container {
      overflow-x: auto;
      margin: 1.5rem 0;
      border-radius: 8px;
      border: 1px solid var(--border-color);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.9rem;
    }

    th {
      background: #0d141e;
      color: var(--samest-blue-light);
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--border-color);
      font-weight: 600;
    }

    td {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid #1a2330;
      color: #e2e8f0;
    }

    .btn-delete-row {
      background: #ef4444;
      color: white;
      border: none;
      padding: 4px 8px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.75rem;
    }

    .summary-box {
      background: #090e15;
      border: 1px solid rgba(27, 92, 164, 0.4);
      border-radius: 10px;
      padding: 1.5rem;
      margin-top: 1.5rem;
    }

    .summary-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 1.3rem;
      font-weight: 800;
      color: #ffffff;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 0.75rem;
      margin-bottom: 1rem;
    }

    .summary-total span {
      color: var(--samest-blue-light);
      font-size: 1.6rem;
    }

    .schedule-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1rem;
      text-align: center;
    }

    .schedule-item {
      background: #111a24;
      padding: 0.85rem;
      border-radius: 8px;
      border: 1px solid var(--border-color);
    }

    .schedule-item strong {
      display: block;
      color: var(--samest-blue-light);
      font-size: 1.05rem;
      margin-top: 4px;
    }

    .trajectory-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.75rem;
    }

    .project-history-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius);
      padding: 2rem;
      transition: all 0.3s ease;
    }

    .project-history-card:hover {
      border-color: var(--samest-blue-bright);
      transform: translateY(-3px);
    }

    .project-history-card h3 {
      font-size: 1.25rem;
      color: #ffffff;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .project-tag {
      font-size: 0.75rem;
      background: rgba(27, 92, 164, 0.25);
      color: var(--samest-blue-light);
      padding: 3px 10px;
      border-radius: 4px;
      border: 1px solid rgba(96, 165, 250, 0.3);
      font-weight: 600;
    }

    .project-details-list {
      list-style: none;
      font-size: 0.88rem;
      color: #cbd5e1;
      margin-top: 0.75rem;
    }

    .project-details-list li {
      margin-bottom: 8px;
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }

    .project-details-list li::before {
      content: "■";
      color: var(--samest-blue-bright);
      font-size: 0.75rem;
      line-height: 1.6;
    }

    /* Galería / Álbum Fotográfico */
    .gallery-filter-bar {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }

    .filter-btn {
      background: #090e15;
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      padding: 0.5rem 1.25rem;
      border-radius: 50px;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .filter-btn:hover, .filter-btn.active {
      background: var(--samest-blue-bright);
      color: #ffffff;
      border-color: var(--samest-blue-light);
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .gallery-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius);
      overflow: hidden;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      cursor: pointer;
    }

    .gallery-card:hover {
      border-color: var(--samest-blue-bright);
      transform: translateY(-4px);
    }

    .gallery-img-wrap {
      width: 100%;
      height: 220px;
      background: #090e15;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .gallery-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .gallery-card:hover .gallery-img-wrap img {
      transform: scale(1.05);
    }

    .gallery-info {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex: 1;
    }

    .gallery-category-tag {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--samest-blue-light);
      letter-spacing: 1px;
      margin-bottom: 0.35rem;
    }

    .gallery-title {
      font-size: 1.05rem;
      color: #ffffff;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }

    .gallery-desc {
      font-size: 0.84rem;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 1rem;
    }

    .gallery-btn-quote {
      margin-top: auto;
      background: rgba(27, 92, 164, 0.2);
      border: 1px solid rgba(96, 165, 250, 0.3);
      color: var(--samest-blue-light);
      padding: 0.45rem 0.85rem;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 600;
      text-align: center;
      text-decoration: none;
      display: block;
      transition: all 0.2s ease;
    }

    .gallery-btn-quote:hover {
      background: var(--samest-blue-bright);
      color: #ffffff;
    }

    /* Modal / Lightbox */
    .lightbox-modal {
      display: none;
      position: fixed;
      z-index: 20000;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(8px);
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .lightbox-content {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius);
      max-width: 800px;
      width: 100%;
      overflow: hidden;
      position: relative;
      animation: modalFadeIn 0.25s ease;
    }

    @keyframes modalFadeIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }

    .lightbox-img-box {
      width: 100%;
      max-height: 480px;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .lightbox-img-box img {
      max-width: 100%;
      max-height: 480px;
      object-fit: contain;
    }

    .lightbox-details {
      padding: 1.5rem;
    }

    .lightbox-close {
      position: absolute;
      top: 15px;
      right: 15px;
      background: rgba(0,0,0,0.6);
      color: #ffffff;
      border: none;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      font-size: 1.2rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .whatsapp-float {
      position: fixed;
      bottom: 25px;
      right: 25px;
      background-color: #25d366;
      color: white;
      width: 62px;
      height: 62px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
      z-index: 10000;
      text-decoration: none;
      transition: transform 0.2s ease;
    }

    .whatsapp-float:hover {
      transform: scale(1.1);
    }

    .whatsapp-float svg {
      width: 34px;
      height: 34px;
      fill: white;
    }

    footer {
      background: #06090e;
      border-top: 1px solid var(--border-color);
      padding: 3.5rem 0 2rem 0;
      margin-top: 4.5rem;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2.5rem;
      margin-bottom: 2.5rem;
    }

    .footer-col h4 {
      color: #ffffff;
      margin-bottom: 1.1rem;
      font-size: 1.15rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .footer-col h4::before {
      content: "";
      width: 4px;
      height: 16px;
      background: var(--samest-blue-bright);
      border-radius: 2px;
    }

    .footer-col p, .footer-col a {
      color: var(--text-muted);
      font-size: 0.92rem;
      text-decoration: none;
      margin-bottom: 0.6rem;
      display: block;
      line-height: 1.6;
    }

    .footer-col a:hover {
      color: var(--samest-blue-light);
    }

    .footer-bottom {
      text-align: center;
      border-top: 1px solid #141c26;
      padding-top: 1.75rem;
      font-size: 0.85rem;
      color: #64748b;
    }

    @media (max-width: 900px) {
      .cotizador-grid { grid-template-columns: 1fr; }
      .social-banner-grid { grid-template-columns: 1fr; }
      .schedule-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 768px) {
      .hero h1 { font-size: 2.1rem; }
      .nav-links { display: none; }
      .form-row { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <header>
    <div class="nav-content">
      <a href="#" class="brand-logo">
        <svg class="logo-icon-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon points="50,12 76,26 66,31 50,22 34,31 24,26" fill="#374151" />
          <polygon points="50,22 66,31 66,36 50,27" fill="#4b5563" />
          <polygon points="50,22 34,31 34,36 50,27" fill="#1f2937" />
          <polygon points="50,29 62,37 62,50 50,57 38,50 38,37" fill="#e5e7eb" />
          <polygon points="46,42 54,42 54,52 46,52" fill="#6b7280" />
          <polygon points="18,34 46,50 46,60 18,44" fill="#1b5ca4" />
          <polygon points="18,44 46,60 46,69 18,53" fill="#14467d" />
          <polygon points="18,53 46,69 46,80 18,64" fill="#1b5ca4" />
          <polygon points="82,34 54,50 54,60 82,44" fill="#0a1f36" />
          <polygon points="82,44 54,60 54,69 82,53" fill="#0d2a4a" />
          <polygon points="82,53 54,69 54,80 82,64" fill="#0a1f36" />
          <polygon points="46,80 54,80 50,86" fill="#1b5ca4" />
        </svg>

        <div class="brand-text-block">
          <div class="brand-title">SAMEST</div>
          <div class="brand-subtitle">ESTRUCTURAS</div>
        </div>
